
# ---- Motor: sqlite | mariadb (también acepta mysql) ----
DB_ENGINE=sqlite
DB_NAME=ecotech.db

# ---- Si usas MariaDB, comenta las 2 líneas de arriba y descomenta estas ----
# DB_ENGINE=mariadb
# DB_NAME=ecotech
# DB_USER=ecotech_app
# DB_PASSWORD=cambia_esta_clave
#
# DB_HOST=localhost        # esta misma PC (XAMPP o Docker)
# DB_HOST=192.168.1.50     # OTRA PC de tu red (o su IP de Tailscale, ej. 100.x.y.z)
# DB_HOST=mi-servidor.com  # un servidor en la nube
# DB_PORT=3306
# DB_TIMEOUT=10            # segundos de espera antes de rendirse si el servidor no responde

# ---- Solo para docker compose (MariaDB + phpMyAdmin en contenedores) ----
# DOCKER_ROOT_PASSWORD=otra_clave_distinta_para_root
# DB_BIND_IP=0.0.0.0       # 0.0.0.0 = acepta otras PC | 127.0.0.1 = solo esta PC
# PMA_BIND_IP=0.0.0.0
# PMA_PORT=8080            # phpMyAdmin en http://localhost:8080
# PMA_REMOTO_PORT=8081     # phpMyAdmin "viajero" (perfil remoto)